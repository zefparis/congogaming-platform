# =====================================================================
# .env.test — COMMITTED ON PURPOSE. Fake values only, NEVER real secrets.
# Loaded automatically by server/env.ts when running under `node --test`
# (detected via NODE_TEST_CONTEXT, set by the test runner in child
# processes). dotenv never overrides variables already set in the
# environment, so real env vars always win.
# =====================================================================
NODE_ENV=test

# 64+ chars, obviously fake — satisfies the min-length schema check only.
JWT_SECRET=test_only_fake_jwt_secret_not_a_real_key_padding_0000000000000000000000000000

SUPABASE_URL=https://fake-tests-only.supabase.co
SUPABASE_SERVICE_KEY=fake-service-role-key-tests-only-not-real

UNIPESA_PUBLIC_ID=fake-unipesa-public-id
UNIPESA_MERCHANT_ID=fake-unipesa-merchant-id
UNIPESA_SECRET_KEY=fake-unipesa-secret-key
UNIPESA_CALLBACK_URL=https://example.invalid/api/unipesa/callback
